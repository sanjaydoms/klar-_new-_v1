# =========================
# Node.js
# =========================
node_modules/

# Lockfiles ARE committed — they are what makes `npm ci` reproducible
# on another machine. Do not add package-lock.json here.

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# TypeScript build output
# =========================
dist/
build/
coverage/
*.tsbuildinfo

# =========================
# Environment variables
# =========================
# Real secrets never get committed; the .env.example templates always do.
.env
.env.*
!.env.example

# =========================
# Logs
# =========================
logs/
*.log

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Temporary files
# =========================
tmp/
temp/
.cache/

# =========================
# Databases / runtime dumps
# =========================
# Only ignore the top-level Mongo data dir, not src/data or flight-service/data,
# both of which hold checked-in reference data (e.g. airports.json).
/data/
*.db
dump.rdb

# =========================
# Test artifacts
# =========================
.nyc_output/

# =========================
# Misc
# =========================
*.pid
*.seed
*.tgz

# =========================
# Local agent / tool state
# =========================
.claude/

# =========================
# Local scratch
# =========================
# Per-package scratch dirs for throwaway probes. Anything worth keeping
# belongs in that package's scripts/ or local-dev/ directory instead.
# Unanchored so they keep working wherever a package sits in the tree.
**/scratch/
**/temp.json
