# flight-service — flight search, booking, ticketing (TripJack)
# Copy to .env and fill in.  Never commit the .env itself.

NODE_ENV=development
PORT=5011
BASE_URL=http://localhost:5011
CRON_ENABLED=false

# ---- MongoDB (MONGODB_URI required) ----
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=flight_service

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- TripJack (all four required — the service throws at boot without them) ----
# UAT / sandbox credentials:
TRIPJACK_TEST_BASE_URL=https://apitest.tripjack.com
TRIPJACK_TEST_API_KEY=
# Production credentials. Required to boot even in development; use the UAT
# values here locally rather than real production keys.
TRIPJACK_PROD_BASE_URL=https://tripjack.com
TRIPJACK_PROD_API_KEY=

# ---- Sibling services ----
AUTHENTICATION_SERVICE=http://127.0.0.1:5010/user
PAYMENT_SERVICE=http://127.0.0.1:5014/api/pay
EMAIL_SERVICE=http://127.0.0.1:5015/api/v1

# Point these at local-dev/collab-stubs.cjs instead when working on flights
# alone (see local-dev/README.md):
#   AUTHENTICATION_SERVICE=http://127.0.0.1:5910/user
#   PAYMENT_SERVICE=http://127.0.0.1:5914/api/pay
#   EMAIL_SERVICE=http://127.0.0.1:5915/api/v1

# ---- Service-to-service auth ----
INTERNAL_SERVICE_KEY=

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ---- Markup ----
PLATFORM_MARKUP_ENABLED=false
PLATFORM_MARKUP_TYPE=FIXED
PLATFORM_MARKUP=0
APPLY_TO=FLIGHT,HOTEL
CURRENCY=INR

# ---- KLAR master accounts (comma-separated user ids) ----
USER_ID=
