{
  "name": "klar-backend-services",
  "version": "1.0.0",
  "private": true,
  "description": "KLAR backend — the microservices behind the B2C and B2B travel platforms",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run install:all && npm run setup:env",
    "install:all": "node scripts/for-each-service.mjs install",
    "setup:env": "node scripts/doctor.mjs --fix",
    "doctor": "node scripts/doctor.mjs",

    "dev": "node scripts/dev.mjs",
    "dev:list": "node scripts/dev.mjs --list",
    "dev:auth": "npm --prefix ./auth-service run dev",
    "dev:flight": "npm --prefix ./flight-service run dev",
    "dev:hotel-search": "npm --prefix ./hotel-search-service run dev",
    "dev:hotel-book": "npm --prefix ./hotel-booking-service run dev",
    "dev:payment": "npm --prefix ./payment-service run dev",
    "dev:email": "npm --prefix ./email-service run dev",
    "dev:cabs": "npm --prefix ./cabs-service run dev",
    "dev:insurance": "npm --prefix ./insurance-service run dev",
    "dev:visa": "npm --prefix ./visa-service run dev",
    "dev:charter": "npm --prefix ./charter-service run dev",
    "dev:tour": "npm --prefix ./tour-package-service run dev",
    "dev:passport": "npm --prefix ./passport-service run dev",
    "dev:engine": "npm --prefix ./hotel-engine run build && npm --prefix ./hotel-engine start",

    "build": "node scripts/for-each-service.mjs run build",
    "typecheck": "node scripts/for-each-service.mjs run typecheck",
    "test": "node scripts/for-each-service.mjs run test",

    "stubs": "node local-dev/collab-stubs.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
