# frontend — KLAR B2C web application (Vite + React)
# Copy to .env and fill in.  Never commit the .env itself.
#
# ⚠ EVERY VITE_ VARIABLE IS BAKED INTO THE BROWSER BUNDLE AND IS PUBLIC.
# Vite inlines them at build time, so anyone can read them with devtools.
# Never put a supplier key, gateway secret or anything else confidential here
# — those belong in a backend service's .env, behind an API.

VITE_ENVIRONMENT=development
VITE_ENABLE_LOGGING=true
VITE_API_TIMEOUT=120000

# ---- Backend services ----
# Defaults in code point at the local ports below, so a locally running backend
# needs no configuration. Set these to point at a deployed environment.
VITE_BACKEND_AUTH_URL=http://localhost:5010
VITE_BACKEND_FLIGHT_URL=http://localhost:5011
VITE_SEARCH_API_URL=http://localhost:5012
VITE_BOOKING_API_URL=http://localhost:5013
VITE_PAYMENT_API_URL=http://localhost:5014
VITE_BACKEND_CABS_URL=http://localhost:5016
# No fallback in code — the insurance calls fail without this.
# NOTE: insurance moved from 5014 to 5017 during the repository cleanup.
VITE_SEARCH_INSURANCE_API_URL=http://localhost:5017
VITE_VISA_BASE_URL=http://localhost:5018
VITE_CHARTER_BASE_URL=http://localhost:5019
VITE_TOURS_BASE_URL=http://localhost:5020
VITE_PASSPORT_BASE_URL=http://localhost:5021
# Cruise has no backend service in this repository yet.
VITE_CRUISE_BASE_URL=

# ---- Third-party browser SDKs ----
# Both are public by design — restrict them by HTTP referrer in the provider
# console rather than by keeping them secret.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=

# ---- Feature flags ----
VITE_DASHBOARD_SEARCH=false

# ---- Development conveniences ----
# Prefill values for booking forms so you are not retyping passenger details.
# Use obvious dummy data — this ships in the bundle.
VITE_TEST_EMAIL=
VITE_TEST_FIRST_NAME=
VITE_TEST_LAST_NAME=
VITE_TEST_MOBILE=
VITE_TEST_PAN=
VITE_TEST_PASSPORT=
VITE_TEST_POSTAL_CODE=

# ---- Should NOT be here ----
# The application also reads VITE_BACKEND_TRIPJACK_API_KEY and
# VITE_SECRET_COUPON. Both are confidential and neither can be kept secret in a
# browser bundle: the TripJack key is a supplier credential, and the coupon
# overrides pricing. Leave them unset and route those calls through a backend
# service. See docs/architecture/02-frontend-architecture.md.
VITE_BACKEND_TRIPJACK_API_KEY=
VITE_SECRET_COUPON=
