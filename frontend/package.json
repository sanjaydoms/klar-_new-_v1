{
  "name": "klar-b2c-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5008",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules dist .cache",
    "pm2:start": "pm2 start npm --name \"klar-b2c-frontend\" -- run preview --port=5008",
    "pm2:stop": "pm2 stop klar-b2c-frontend",
    "pm2:restart": "pm2 stop klar-b2c-frontend && npm run build && pm2 restart klar-b2c-frontend",
    "pm2:delete": "pm2 delete klar-b2c-frontend",
    "pm2:logs": "pm2 logs klar-b2c-frontend",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:monit": "pm2 monit",
    "deploy": "git pull && npm install && npm run build && pm2 restart klar-b2c-frontend",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@react-google-maps/api": "^2.20.8",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.11.2",
    "@supabase/supabase-js": "^2.57.4",
    "@types/leaflet": "^1.9.21",
    "airport-codes": "^1.0.2",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "3.2.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "i18n-iso-countries": "^7.14.0",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "radix-ui": "^1.6.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "react-select": "^5.10.2",
    "redux-persist": "^6.0.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "3.0.5",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.0",
    "@types/react-icons": "^2.2.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fast-check": "^4.8.0",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.9"
  },
  "description": "KLAR B2C customer web application",
  "engines": {
    "node": ">=20"
  }
}
