# insurance-service — travel insurance (TripJack TripSafe v6.0)
# Copy to .env and fill in.  Never commit the .env itself.
# This service also reads .env.local, which is loaded before .env.

NODE_ENV=development
# NOTE: this used to default to 5014, which collided with payment-service.
# The canonical local port for insurance is now 5017.
PORT=5017

# ---- MongoDB ----
# Without this the service boots but persists no insurance bookings.
MONGODB_URI=mongodb://127.0.0.1:27017

# ---- Auth ----
# Must match auth-service's JWT_SECRET or every authenticated call 401s.
JWT_SECRET=

# ---- Supplier: TripJack TripSafe ----
# TEST pair is used whenever NODE_ENV is not "production".
TRIPJACK_TEST_BASE_URL=https://apitest.tripjack.com
TRIPJACK_TEST_API_KEY=
# PROD pair is used when NODE_ENV=production.
TRIPJACK_BASE_URL=https://api.tripjack.com
TRIPJACK_API_KEY=
