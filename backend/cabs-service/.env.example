# cabs-service — airport transfers and intercity cabs (TripJack Cabs v2.0)
# Copy to .env and fill in.  Never commit the .env itself.

NODE_ENV=development
PORT=5016

# ---- MongoDB / Redis ----
# Without MONGODB_URI the service still boots but persists nothing.
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional. When unset the distributed booking lock becomes a no-op.
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# Must match auth-service's JWT_SECRET or every authenticated call 401s.
JWT_SECRET=
AUTH_SERVICE_URL=http://localhost:5010

# ---- Sibling services ----
PAYMENT_SERVICE_URL=http://localhost:5014/api/pay
EMAIL_SERVICE_URL=http://localhost:5015/api/v1

# ---- Service-to-service auth ----
# Without this, automatic refunds are disabled and unresolved bookings are
# parked in MANUAL_REVIEW for ops. The service warns loudly at boot.
INTERNAL_SERVICE_KEY=

# ---- Supplier: TripJack Cabs ----
TRIPJACK_BASE_URL=https://apitest-cabs.tripjack.com
TRIPJACK_API_KEY=
# Must be the numeric agency id that owns the API key above, or bookings are
# created and then fail payment with Access Denied.
TRIPJACK_AGENCY_ID=

# ---- Booking safety ----
# Allowed upward price drift between search and book; the larger of the two wins.
PRICE_TOLERANCE_FIXED=50
PRICE_TOLERANCE_PERCENT=5
STRICT_VEHICLE_VALIDATION=true
# If Redis is unreachable, whether to proceed without the booking lock.
LOCK_FAIL_OPEN=false
ENABLE_AUTO_REFUNDS=true

# ---- Markup ----
CAB_PLATFORM_MARKUP_ENABLED=false
CAB_PLATFORM_MARKUP_TYPE=FIXED
CAB_PLATFORM_MARKUP_VALUE=0
CAB_B2C_MARKUP_ENABLED=false
CAB_B2C_MARKUP_TYPE=FIXED
CAB_B2C_MARKUP_VALUE=0
