# auth-service — accounts, JWT sessions, wallet, markup master config
# Copy to .env and fill in.  Never commit the .env itself.

NODE_ENV=development
PORT=5010
API_PREFIX=/api
BASE_URL=http://localhost:5010

# ---- MongoDB (required) ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=klar_auth

# ---- JWT ----
# Defaults exist in code but are placeholders — always set these.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS (required — the service throws at boot if any is missing) ----
CORS_ORIGIN=http://localhost:5008
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ---- Sibling services (required) ----
EMAIL_BASE_URL=http://localhost:5015/api/v1
BOOKING_SERVICE_URL=http://localhost:5011
FRONTEND_URL=http://localhost:5008

# ---- Service-to-service auth ----
# Shared secret for internal wallet routes. Must be byte-identical in every
# service that calls them (flight, hotel-booking, cabs, payment).
INTERNAL_SERVICE_KEY=

# ---- Google sign-in ----
GOOGLE_CLIENT_ID=

# ---- KLAR master accounts (comma-separated user ids) ----
# A second factor on top of the MASTER role for platform-wide pricing config.
USER_ID=
