# hotel-engine — supplier-agnostic hotel OTA engine (Phase 2 rewrite)
# Copy to .env and fill in.  Never commit the .env itself.
#
# IMPORTANT: this is NOT a drop-in replacement for hotel-search-service and
# hotel-booking-service. It runs alongside them and is not yet wired into the
# frontend. See docs/architecture/05-integration-architecture.md.

# Defaults to 5030. It used to default to 5012, which collided with
# hotel-search-service.
PORT=5030

# ---- Postgres (REQUIRED — the engine refuses to start without it) ----
# Unlike every other service in this repository, the engine is backed by
# PostgreSQL, not MongoDB. You need a running Postgres before `npm start`:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=klar --name klar-pg postgres:16
DATABASE_URL=postgres://postgres:klar@127.0.0.1:5432/klar_hotel_engine
DATABASE_POOL_MAX=10
# Set to "true" on first run to create the schema.
RUN_MIGRATIONS=false

# ---- Markup rules (REQUIRED — the engine refuses to start without it) ----
# A JSON array of markup rules. It must be NON-EMPTY: an absent or empty rule
# set would mean selling at cost, so the engine refuses it rather than
# defaulting. See docs/adr/0007-confirmed-commercial-defaults.md for the shape.
KLAR_MARKUP_RULES=

# ---- Redis ----
# Same contract as DATABASE_URL: optional, but must have `ioredis` installed
# if set.
REDIS_URL=

# ---- Auth ----
KLAR_AUTH_JWT_SECRET=

# ---- Supplier: TripJack ----
TRIPJACK_HMS_BASE_URL=https://apitest-hms.tripjack.com
TRIPJACK_OMS_BASE_URL=https://apitest-oms.tripjack.com
TRIPJACK_API_KEY=
TRIPJACK_AGENCY_ID=
TRIPJACK_IMAGE_BASE_URL=

# ---- Supplier: RateGain ----
RATEGAIN_BASE_URL=
RATEGAIN_API_KEY=
RATEGAIN_API_SECRET=
RATEGAIN_IMAGE_BASE_URL=

# ---- Platform ----
KLAR_CORS_ORIGINS=http://localhost:5008
KLAR_HOME_COUNTRY=IN
KLAR_WARM_TARGETS=
KLAR_PAYLOAD_RETENTION_DAYS=30
KLAR_RATE_LIMIT_WINDOW_MS=60000
KLAR_RATE_LIMIT_MAX_REQUESTS=120
