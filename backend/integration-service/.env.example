NODE_ENV=development
PORT=5022

MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=klar_integrations

# Must match auth-service — this service verifies its tokens, it never issues any.
JWT_SECRET=

# Comma-separated. Empty locks every master-only route (fails closed, by design).
MASTER_EMAILS=

# Shared secret other KLAR services present to fetch decrypted credentials.
INTERNAL_SERVICE_KEY=

# 32 bytes of hex (64 chars) for credential encryption at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this makes every stored credential unrecoverable — back it up somewhere
# that is not this repository.
INTEGRATION_MASTER_KEY=

# Where email alerts are queued. Alerts degrade to "could not reach" without it.
EMAIL_SERVICE_URL=http://localhost:5015/api/v1

CORS_ORIGIN=http://localhost:5009
CORS_CREDENTIALS=true
