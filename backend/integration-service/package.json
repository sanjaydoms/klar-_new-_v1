{
  "name": "integration-service",
  "version": "1.0.0",
  "description": "KLAR API & Integration Control Center — provider registry, routing, credentials, health",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "clean": "rimraf node_modules dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "import-credentials": "ts-node src/scripts/import-credentials.ts",
    "pm2:start": "pm2 start dist/server.js --name integration-service",
    "pm2:stop": "pm2 stop integration-service",
    "pm2:restart": "pm2 restart integration-service",
    "pm2:delete": "pm2 delete integration-service",
    "pm2:logs": "pm2 logs integration-service",
    "pm2:status": "pm2 status",
    "deploy": "git pull && npm install && npm run build && pm2 restart integration-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
