{
  "name": "hotel-search-service",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --require ts-node/register --test \"src/**/*.test.ts\"",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch sync_progress_tj_hotels.json src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "backfill:tokens": "ts-node --transpile-only scripts/backfillSearchTokens.ts",
    "ensure:indexes": "ts-node --transpile-only scripts/ensureHotelIndexes.ts",
    "validate:aliases": "ts-node --transpile-only scripts/validateCityAliases.ts",
    "sync:hotels": "ts-node --transpile-only scripts/syncHotels.ts",
    "format": "prettier --write .",
    "clean": "rm -rf dist node_modules",
    "deepclean": "rm -rf dist node_modules package-lock.json",
    "pm2:start": "pm2 start dist/server.js --name klar-hotel-search-service",
    "pm2:start:dev": "pm2 start src/server.ts --name klar-hotel-search-service-dev --interpreter ts-node",
    "pm2:stop": "pm2 stop klar-hotel-search-service",
    "pm2:restart": "npm run clean && npm i && npm run build && pm2 restart klar-hotel-search-service",
    "pm2:delete": "pm2 delete klar-hotel-search-service",
    "pm2:logs": "pm2 logs klar-hotel-search-service",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "deploy": "git pull && npm install && npm run build && pm2 restart klar-hotel-search-service",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "prettier": "^3.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
