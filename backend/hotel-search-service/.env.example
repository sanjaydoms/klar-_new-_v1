# hotel-search-service — hotel search, suggest, static content, facets
# Copy to .env and fill in.  Never commit the .env itself.
# This service also reads .env.local first, which overrides .env.
#
# Only the variables below are needed to boot. The service exposes a further
# ~50 tuning knobs (cache TTLs, page sizes, supplier timeouts, warmup) that all
# have sensible defaults in src/config/env.ts — read that file before overriding
# any of them; the comments there explain what each one costs.

NODE_ENV=development
PORT=5012

# ---- MongoDB / Redis ----
MONGODB_URI=mongodb://127.0.0.1:27017
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# Must match auth-service's JWT_SECRET or every authenticated call 401s.
JWT_SECRET=
AUTH_SERVICE_URL=http://localhost:5010
INTERNAL_SERVICE_KEY=

# ---- Supplier: RateGain ----
RATEGAIN_BASE_URL=
RATEGAIN_API_KEY=
RATEGAIN_SECRET_KEY=

# ---- Supplier: TripJack ----
TRIPJACK_BASE_URL=https://apitest-hms.tripjack.com
TRIPJACK_API_KEY=
# Must be the numeric agency id that owns the API key above.
TRIPJACK_AGENCY_ID=
TRIPJACK_IMAGE_BASE=

# ---- Which suppliers to query: tripjack | rategain | both ----
HOTEL_PROVIDER_MODE=both

# ---- Geocoding (city/landmark lookup) ----
OPENCAGE_API_KEY=

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5008

# ---- Home market ----
HOME_COUNTRY_CODE=IN
HOME_COUNTRY_NAME=India

# ---- Background work (both off by default; they spend supplier quota) ----
ENABLE_AUTO_SYNC=false
ENABLE_SEARCH_WARMUP=false

# ---- Markup ----
HOTEL_MARKUP_ON=false
PLATFORM_MARKUP_ENABLED=false
PLATFORM_MARKUP_TYPE=FIXED
PLATFORM_MARKUP_VALUE=0
B2C_MARKUP_ENABLED=false
B2C_MARKUP_TYPE=FIXED
B2C_MARKUP_VALUE=0
