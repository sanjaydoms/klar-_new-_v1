# hotel-search-service — hotel search, suggest, static content, facets
# Copy to .env and fill in.  Never commit the .env itself.
# This service also reads .env.local first, which overrides .env.
#
# Only the variables below are needed to boot. The service exposes a further
# ~50 tuning knobs (cache TTLs, page sizes, supplier timeouts, warmup) that all
# have sensible defaults in src/config/env.ts — read that file before overriding
# any of them; the comments there explain what each one costs.

NODE_ENV=development
PORT=5012

# ---- MongoDB / Redis ----
MONGODB_URI=mongodb://127.0.0.1:27017
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# Must match auth-service's JWT_SECRET or every authenticated call 401s.
JWT_SECRET=
AUTH_SERVICE_URL=http://localhost:5010
INTERNAL_SERVICE_KEY=
# Admin plane. Absent or unreachable means routing falls back to
# HOTEL_PROVIDER_MODE below, exactly as this service behaved before it existed.
INTEGRATION_SERVICE_URL=http://localhost:5022

# ---- Supplier: RateGain ----
RATEGAIN_BASE_URL=
RATEGAIN_API_KEY=
RATEGAIN_SECRET_KEY=

# ---- Supplier: TripJack ----
TRIPJACK_BASE_URL=https://apitest-hms.tripjack.com
TRIPJACK_API_KEY=
# Must be the numeric agency id that owns the API key above.
TRIPJACK_AGENCY_ID=
TRIPJACK_IMAGE_BASE=
# Host for TripJack STATIC content (the hotel-master sync). Defaults to
# api.tripjack.com and should normally be LEFT UNSET — probing on 2026-08-19
# found that endpoint is served only there: apitest.tripjack.com returns a
# Cloudflare 504 and apitest-hms.tripjack.com a bare 403.
#
# The sync therefore needs a PRODUCTION TRIPJACK_API_KEY. A test key gets
# HTTP 200 with {"errCode":"412","message":"...API key is invalid"} — the sync
# now throws on that rather than reporting "0 hotels".
#
# With RateGain retired this sync IS the searchable inventory: no key, no site.
TJ_STATIC_BASE_URL=

# ---- Withdrawn-hotel pruning (runs at the end of every completed hotel sync) ----
# How many days back to ask the withdrawal feed for. A rolling window, not a
# saved timestamp: deleting an already-deleted hotel is a no-op, so a missed run
# heals itself on the next one as long as the gap is shorter than this.
TJ_DELETED_LOOKBACK_DAYS=30
# Safety ceiling: refuse to delete more than this FRACTION of the catalogue in
# one run. Withdrawals are a trickle; a feed asking to remove a tenth of the
# database is a misread response, and deleteMany does not come back. Raise it
# only after confirming with TripJack that a large batch is genuine.
TJ_MAX_DELETE_RATIO=0.1

# ---- Which suppliers to query: both | tripjack | rategain (aka UNIFIED | TJ_ONLY | RG_ONLY) ----
# RateGain is retired from SEARCH — leave this as `tripjack`.
#
# Read by hotel-search-service ONLY. hotel-booking-service routes by the stored
# booking's provider, so existing RateGain reservations stay cancellable and
# refundable regardless of this value. Do not delete the RateGain supplier code
# to "finish" the retirement — that strands live bookings.
#
# An unrecognised value used to match no supplier and silently return zero
# hotels for every search; it now warns and falls back to UNIFIED.
HOTEL_PROVIDER_MODE=tripjack

# ---- Geocoding (city/landmark lookup) ----
OPENCAGE_API_KEY=

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5008

# ---- Home market ----
HOME_COUNTRY_CODE=IN
HOME_COUNTRY_NAME=India

# ---- Background work (both off by default; they spend supplier quota) ----
ENABLE_AUTO_SYNC=false
ENABLE_SEARCH_WARMUP=false

# ---- Markup ----
HOTEL_MARKUP_ON=false
PLATFORM_MARKUP_ENABLED=false
PLATFORM_MARKUP_TYPE=FIXED
PLATFORM_MARKUP_VALUE=0
B2C_MARKUP_ENABLED=false
B2C_MARKUP_TYPE=FIXED
B2C_MARKUP_VALUE=0
