# email-service — transactional mail, queued through BullMQ on Redis
# Copy to .env and fill in.  Never commit the .env itself.
# Every variable below is required — the service throws at boot without them.

NODE_ENV=development
PORT=5015

# ---- Redis (required — BullMQ queue backend) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Sender identity ----
DEFAULT_FROM_EMAIL=no-reply@klar.example
DEFAULT_FROM_NAME=KLAR
DEFAULT_REPLY_TO=support@klar.example

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:5008
