# passport-service — passport application assistance
# Copy to .env and fill in.  Never commit the .env itself.

NODE_ENV=development
# NOTE: this used to default to 5000, which collided with email-service.
# The canonical local port for passport is now 5021.
PORT=5021

# ---- MongoDB ----
# NOTE: this service uses MONGO_URI, not MONGODB_URI like most of the repo.
MONGO_URI=mongodb://127.0.0.1:27017/klar_passport
