# hotel-booking-service — hotel pricing, booking, cancellation, vouchers
# Copy to .env and fill in.  Never commit the .env itself.

NODE_ENV=development
PORT=5013

# ---- MongoDB / Redis ----
MONGODB_URI=mongodb://127.0.0.1:27017
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# Must match auth-service's JWT_SECRET or every authenticated call 401s.
JWT_SECRET=
AUTH_SERVICE_URL=http://localhost:5010

# ---- Sibling services ----
PAYMENT_SERVICE_URL=http://localhost:5014/api/pay
EMAIL_SERVICE_URL=http://localhost:5015/api/v1

# ---- Service-to-service auth ----
# Without this, automatic refunds are disabled and unresolved bookings are
# parked in MANUAL_REVIEW for ops. The service warns loudly at boot.
INTERNAL_SERVICE_KEY=
# Admin plane. Absent or unreachable simply means no health data is reported —
# nothing on the booking path depends on it.
INTEGRATION_SERVICE_URL=http://localhost:5022

# ---- Supplier: RateGain (service logs a hard error at boot without these) ----
RATEGAIN_BASE_URL=
RATEGAIN_API_KEY=
RATEGAIN_SECRET_KEY=

# ---- Supplier: TripJack ----
TRIPJACK_BASE_URL=https://apitest-hms.tripjack.com
TRIPJACK_OMS_BASE_URL=https://apitest-oms.tripjack.com
TRIPJACK_API_KEY=
# Must be the numeric agency id that owns the API key above, or bookings are
# created and then fail payment with Access Denied.
TRIPJACK_AGENCY_ID=

# ---- Booking safety ----
# Reject a booking whose price drifted upward between search and book.
STRICT_ROOM_VALIDATION=true
# If Redis is unreachable, whether to proceed without the booking lock.
LOCK_FAIL_OPEN=false
ENABLE_AUTO_REFUNDS=true

# ---- FX ----
FX_API_URL=
FX_CACHE_TTL_MS=3600000
FX_FETCH_TIMEOUT_MS=5000
# Static fallback table, e.g. {"USD":83.5,"EUR":90.1}
FX_RATES_JSON=

# ---- Markup ----
PLATFORM_MARKUP_ENABLED=false
PLATFORM_MARKUP_TYPE=FIXED
PLATFORM_MARKUP_VALUE=0
B2C_MARKUP_ENABLED=false
B2C_MARKUP_TYPE=FIXED
B2C_MARKUP_VALUE=0

# ---- Internal coupon override ----
SECRET_SYSTEM_COUPON=
